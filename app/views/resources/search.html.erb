<main class="inner-page resource-page">
  <div class="breadcrumb"><%= link_to "Início", root_path %><span>/</span><%= link_to "Recursos", resources_path %><span>/</span><strong>Busca</strong></div>
  <section class="resource-hero">
    <p class="eyebrow">BUSCA NO CONTEÚDO</p><h1><%= @title %></h1><p>Pesquise por tema, conceito ou nome de trilha.</p>
    <%= form_with url: search_path, method: :get, class: "resource-search" do |form| %>
      <%= form.label :q, "Termo de busca" %><div><%= form.search_field :q, value: @query, placeholder: "Ex.: titulação, pH, cromatografia", required: true %><%= form.submit "Buscar", class: "button button-primary" %></div>
    <% end %>
  </section>
  <% if @query.present? %>
    <section class="resource-group"><h2>Resultados para “<%= @query %>”</h2>
      <% if @results.any? %><div class="resource-entry-list">
        <% @results.each do |lesson| %>
          <%= link_to lesson_path(subject_slug: lesson.subject.slug, id: lesson.id), class: "search-result" do %>
            <span class="eyebrow"><%= lesson.subject.name %> · <%= lesson.assessment? ? "AVALIAÇÃO FINAL" : "MÓDULO #{lesson.position.to_s.rjust(2, "0")}" %></span><strong><%= lesson.title %></strong><p><%= lesson.summary %></p>
          <% end %>
        <% end %>
      </div><% end %>
      <% if @resource_results.any? %><div class="resource-entry-list">
        <% @resource_results.each do |result| %>
          <%= link_to result[:path], class: "search-result" do %><span class="eyebrow"><%= result[:kind] %></span><strong><%= result[:title] %></strong><p><%= result[:description] %></p><% end %>
        <% end %>
      </div><% end %>
      <% if @results.empty? && @resource_results.empty? %><p>Nenhum resultado encontrado. Tente outro termo ou explore o <%= link_to "glossário", glossary_path %>.</p><% end %>
    </section>
  <% end %>
</main>
