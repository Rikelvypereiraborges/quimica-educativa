<main class="inner-page lesson-page">
  <div class="breadcrumb"><%= link_to "Início", root_path %><span>/</span><%= link_to @subject.name, subject_path(@subject.slug) %><span>/</span><strong><%= @lesson.title %></strong></div>

  <div class="lesson-layout">
    <article class="lesson-content">
      <p class="eyebrow">TRILHA <%= @subject.position.to_s.rjust(2, "0") %> · <%= @lesson.assessment? ? "AVALIAÇÃO FINAL" : "MÓDULO #{@lesson.position.to_s.rjust(2, "0")} · #{@lesson.difficulty_label.upcase}" %></p>
      <h1><%= @lesson.title %></h1>
      <p class="lesson-lead"><%= @lesson.summary %></p>
      <% unless @lesson.assessment? %>
        <section class="lesson-objectives">
          <div><strong>Objetivos de aprendizagem</strong><ul><li>Explicar os conceitos centrais de <%= @lesson.title.downcase %>.</li><li>Relacionar a teoria a uma aplicação de laboratório ou processo.</li><li>Interpretar dados e unidades antes de tirar conclusões.</li></ul></div>
          <div class="lesson-time"><span><%= [@lesson.concept.split.size / 25, 10].max %> min</span><small>tempo estimado</small></div>
        </section>
        <p class="lesson-prerequisite"><strong>Antes de começar:</strong> familiarize-se com <%= link_to(@previous_lesson ? @previous_lesson.title : "os fundamentos desta trilha", @previous_lesson ? lesson_path(subject_slug: @subject.slug, id: @previous_lesson.id) : subject_path(@subject.slug)) %>. Consulte também a <%= link_to "folha de fórmulas", formulas_path %> quando usar equações.</p>
      <% end %>

      <div class="concept-card"><span class="concept-label"><%= @lesson.assessment? ? "ORIENTAÇÕES" : "A IDEIA PRINCIPAL" %></span><p><%= @lesson.concept %></p></div>

      <section class="example-card"><span class="example-icon">✳</span><div><span class="concept-label">NA PRÁTICA</span><p><%= @lesson.example %></p></div></section>
      <% unless @lesson.assessment? %>
        <section class="lesson-study-links" aria-label="Materiais de apoio para esta aula">
          <strong>Continue estudando</strong>
          <%= link_to "Consultar fórmulas e unidades →", formulas_path %>
          <%= link_to "Buscar termos no glossário →", glossary_path %>
          <%= link_to "Ver roteiros de laboratório →", laboratory_guides_path %>
          <%= link_to "Consultar segurança e FDS →", safety_path %>
        </section>
      <% end %>

      <section class="exercise-card" id="exercicio">
        <div class="exercise-heading"><div><p class="eyebrow"><%= @lesson.assessment? ? "REVISÃO DO CONTEÚDO" : "HORA DE PRATICAR" %></p><h2><%= @lesson.assessment? ? "Teste " : "Você " %><span><%= @lesson.assessment? ? "final" : "consegue?" %></span></h2></div><span class="exercise-xp">✦ +<%= @lesson.xp %> XP</span></div>
        <% if @quiz_questions.any? %>
          <p class="exercise-question assessment-instructions">Responda às <%= @quiz_questions.size %> questões deste <%= @lesson.assessment? ? "teste da trilha" : "módulo" %>. Você precisa acertar pelo menos <%= @assessment_passing_score %> para concluir e ganhar XP.</p>
          <%= form_with url: answer_lesson_path(subject_slug: @subject.slug, id: @lesson.id), method: :post, class: "answer-form" do %>
            <% @quiz_questions.each_with_index do |question, index| %>
              <fieldset class="assessment-question">
                <legend><span class="assessment-question-number">Questão <%= index + 1 %></span><%= question.question %></legend>
                <div class="answer-options">
                  <% question.answer_options.each do |key, answer| %>
                    <% input_id = "answer_#{question.id}_#{key}" %>
                    <label class="answer-option" for="<%= input_id %>">
                      <%= radio_button_tag "answers[#{question.id}]", key, @assessment_feedback&.dig("answers", question.id.to_s) == key, id: input_id, required: true %>
                      <span class="answer-letter"><%= key.upcase %></span>
                      <span class="answer-copy"><%= answer %></span>
                    </label>
                  <% end %>
                </div>
                <% if @assessment_feedback %>
                  <% correct = @assessment_feedback.dig("answers", question.id.to_s) == question.correct_option %>
                  <% selected = @assessment_feedback.dig("answers", question.id.to_s) %>
                  <p class="assessment-question-feedback <%= correct ? "is-correct" : "needs-review" %>"><strong><%= correct ? "Resposta correta." : "Sua resposta: #{selected&.upcase} · Gabarito: #{question.correct_option.upcase}." %></strong> <%= question.explanation %></p>
                <% end %>
              </fieldset>
            <% end %>
            <button type="submit" class="button button-primary answer-submit"><%= @lesson.assessment? ? "Enviar teste" : "Enviar respostas" %> <span aria-hidden="true">→</span></button>
          <% end %>
        <% else %>
          <p class="exercise-question"><%= @lesson.question %></p>
          <%= form_with url: answer_lesson_path(subject_slug: @subject.slug, id: @lesson.id), method: :post, class: "answer-form" do %>
            <div class="answer-options">
              <% @lesson.answer_options.each do |key, answer| %>
                <label class="answer-option" for="answer_<%= key %>">
                  <%= radio_button_tag :answer, key, false, id: "answer_#{key}", required: true %>
                  <span class="answer-letter"><%= key.upcase %></span>
                  <span class="answer-copy"><%= answer %></span>
                </label>
              <% end %>
            </div>
            <button type="submit" class="button button-primary answer-submit">Conferir resposta <span aria-hidden="true">→</span></button>
          <% end %>
        <% end %>
        <% if flash[:notice] %><div class="quiz-feedback feedback-correct" role="status"><span>✓</span><p><%= flash[:notice] %></p></div><% end %>
        <% if flash[:alert] %><div class="quiz-feedback feedback-retry" role="alert"><span>↻</span><p><%= flash[:alert] %></p></div><% end %>
        <% if @completed %><p class="completed-note">✓ Etapa concluída — você já conquistou os pontos desta etapa.</p><% end %>
      </section>

      <div class="lesson-navigation">
        <%= link_to "← Todas as aulas", subject_path(@subject.slug), class: "back-link" %>
        <% if @next_lesson %><%= link_to "Próximo módulo →", lesson_path(subject_slug: @subject.slug, id: @next_lesson.id), class: "back-link" %><% else %><%= link_to "Próxima trilha →", root_path(anchor: "trilhas"), class: "back-link" %><% end %>
      </div>
    </article>
    <aside class="lesson-aside">
      <div class="aside-card"><span class="aside-icon"><%= @subject.icon %></span><p class="eyebrow">SUA TRILHA</p><h2><%= @subject.name %></h2><%= link_to "Ver todas as aulas →", subject_path(@subject.slug), class: "aside-link" %></div>
      <div class="aside-tip"><span>✦ DICA</span><p>Errou? Tudo bem. Leia a explicação e tente de novo. É assim que o aprendizado acontece.</p></div>
      <div class="aside-tip"><span>REVISÃO</span><p>Questões erradas são lembradas em <%= link_to "Revisão", review_path %> após três dias para apoiar a prática espaçada.</p></div>
      <div class="aside-tip"><span>REFERÊNCIAS</span><p>Confira fontes técnicas e dados em <%= link_to "Biblioteca e referências", references_path %>.</p></div>
    </aside>
  </div>
</main>
