<main class="inner-page">
  <div class="breadcrumb"><%= link_to "Início", root_path %><span>/</span><span>Trilhas</span><span>/</span><strong><%= @subject.name %></strong></div>
  <% lessons = @subject.lessons.to_a %>
  <% assessment_count = lessons.count(&:assessment?) %>
  <% modules = lessons.reject(&:assessment?) %>

  <section class="subject-hero" style="--subject-color: <%= @subject.color %>">
    <div>
      <p class="eyebrow">TRILHA <%= @subject.position.to_s.rjust(2, "0") %> · FUNDAMENTOS</p>
      <h1><%= @subject.name %></h1>
      <p><%= @subject.description %></p>
      <div class="subject-meta"><span><% if assessment_count.positive? %><%= assessment_count %> <%= assessment_count == 1 ? "avaliação final" : "avaliações finais" %> · <%= lessons.size %> etapas<% else %><%= lessons.size %> <%= lessons.size == 1 ? "aula introdutória" : "aulas introdutórias" %><% end %></span><span>·</span><span>Aprenda no seu ritmo</span></div>
    </div>
    <span class="subject-hero-icon" aria-hidden="true"><%= @subject.icon %></span>
  </section>

  <section class="lesson-list-section">
    <div class="lesson-list-heading"><div><p class="eyebrow">SUA JORNADA</p><h2>Comece pelo <span>começo.</span></h2></div><span class="lesson-total"><%= @completed_module_count %>/<%= modules.size %> módulos · 70% para aprovação</span></div>
    <div class="track-guidance">
      <p><strong>Objetivo:</strong> <%= @subject.description %></p>
      <p><strong>Tempo estimado:</strong> cerca de <%= [modules.size * 20, 30].max %> minutos de estudo, sem contar a prática independente.</p>
      <p><strong>Pré-requisitos:</strong> comece pelos módulos iniciais; quando necessário, use <%= link_to "Química I", subject_path("quimica-i") %> e o <%= link_to "glossário", glossary_path %> como apoio.</p>
      <div class="track-progress" role="progressbar" aria-label="Progresso dos módulos" aria-valuemin="0" aria-valuemax="<%= modules.size %>" aria-valuenow="<%= @completed_module_count %>"><span style="width: <%= modules.empty? ? 0 : (@completed_module_count * 100.0 / modules.size).round %>%"></span></div>
      <small><%= @completed_module_count %> de <%= modules.size %> módulos concluídos. A avaliação final fica no fim da sequência; são necessárias 7 de 10 respostas corretas.</small>
    </div>
    <div class="lesson-list" aria-label="Módulos em ordem">
      <% modules.each do |lesson| %>
        <% completed = @completed_lesson_ids.include?(lesson.id.to_s) %>
        <%= link_to lesson_path(subject_slug: @subject.slug, id: lesson.id), class: "lesson-row" do %>
          <span class="lesson-number <%= "is-complete" if completed %>"><%= completed ? "✓" : lesson.position.to_s.rjust(2, "0") %></span>
          <span class="lesson-row-copy"><strong><%= lesson.title %></strong><small><%= lesson.summary %></small></span>
          <span class="lesson-level-badge"><%= lesson.difficulty_label %></span>
          <span class="lesson-xp">✦ <%= lesson.xp %> XP</span>
          <span class="lesson-row-arrow" aria-hidden="true">→</span>
        <% end %>
      <% end %>
    </div>
    <% if @assessment %>
      <section class="lesson-level-section lesson-assessment-section">
        <div class="lesson-level-heading"><div><p class="eyebrow">ÚLTIMA ETAPA · NOTA MÍNIMA 70%</p><h3>Avaliação final</h3></div></div>
        <div class="lesson-list">
          <% completed = @completed_lesson_ids.include?(@assessment.id.to_s) %>
          <%= link_to lesson_path(subject_slug: @subject.slug, id: @assessment.id), class: "lesson-row" do %>
            <span class="lesson-number <%= "is-complete" if completed %>"><%= completed ? "✓" : @assessment.position.to_s.rjust(2, "0") %></span>
            <span class="lesson-row-copy"><strong><%= @assessment.title %></strong><small>Teste final · 10 questões · mínimo de 7 acertos · tentativas livres</small></span>
            <span class="lesson-xp">✦ <%= @assessment.xp %> XP</span>
            <span class="lesson-row-arrow" aria-hidden="true">→</span>
          <% end %>
        </div>
      </section>
    <% end %>
    <% if @track_complete %>
      <%= link_to "Emitir comprovante imprimível →", certificate_path(@subject.slug), class: "button button-primary certificate-link" %>
    <% else %>
      <p class="certificate-locked">Conclua todos os módulos e a avaliação final para liberar o comprovante desta trilha.</p>
    <% end %>
    <%= link_to "← Ver todas as trilhas", root_path(anchor: "trilhas"), class: "back-link" %>
  </section>
</main>
